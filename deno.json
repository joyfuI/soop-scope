{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "imports": {
    "@biomejs/biome": "npm:@biomejs/biome@^2.5.11",
    "@emotion/react": "npm:@emotion/react@^11.14.0",
    "@emotion/styled": "npm:@emotion/styled@^11.14.1",
    "@mui/material": "npm:@mui/material@^9.4.0",
    "@rolldown/plugin-babel": "npm:@rolldown/plugin-babel@^0.2.3",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@tanstack/react-query": "npm:@tanstack/react-query@^5.102.8",
    "@tanstack/react-query-devtools": "npm:@tanstack/react-query-devtools@^5.102.8",
    "@types/react": "npm:@types/react@^19.2.18",
    "@types/react-dom": "npm:@types/react-dom@^19.2.5",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.1.1",
    "babel-plugin-react-compiler": "npm:babel-plugin-react-compiler@^1.0.0",
    "react": "npm:react@^19.2.8",
    "react-dom": "npm:react-dom@^19.2.8",
    "soop-extension": "npm:soop-extension@^1.3.3",
    "vite": "npm:vite@^8.2.2"
  },
  "tasks": {
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:desktop": "export DENO_DESKTOP_DEV_URL=http://127.0.0.1:5173 && deno desktop --hmr -A desktop/main.ts --dev",
    "dev": { "dependencies": ["dev:web", "dev:desktop"] },
    "check:web": "deno check src/main.tsx src/vite-env.d.ts src/desktop-bindings.d.ts vite.config.ts",
    "check:desktop": "deno check desktop/main.ts",
    "typecheck": { "dependencies": ["check:web", "check:desktop"] },
    "build:web": { "command": "vite build", "dependencies": ["check:web"] },
    "build": {
      "command": "deno desktop --node-modules-dir=none --exclude-unused-npm --allow-read --allow-net --allow-env=WS_NO_BUFFER_UTIL --allow-run=rundll32.exe --include=dist desktop/main.ts",
      "dependencies": ["check:desktop", "build:web"]
    },
    "preview": "vite preview",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write",
    "reporter": "biome check --reporter=summary"
  },
  "desktop": {
    "app": {
      "name": "soop-scope",
      "identifier": "com.joyfui.soop-scope",
      "icons": { "windows": "./public/icon.ico" }
    },
    "backend": "webview",
    "output": { "windows": "./release/soop-scope" }
  }
}
